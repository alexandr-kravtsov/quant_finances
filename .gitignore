# ==========================================
# 1. ТЯЖЕЛЫЕ ДАННЫЕ (Игнорируем по умолчанию)
# ==========================================
data/for_ml/storage/
archive/storage/

# ==========================================
# 2. РАЗРЕШАЕМ папку с сэмплами (Порядок важен!)
# ==========================================
!data/for_ml/storage/sample_storage/
!data/for_ml/storage/sample_storage/**/*.parquet
!data/for_ml/storage/sample_storage/**/*.csv
!data/for_ml/storage/sample_storage/**/*.json

# ==========================================
# 3. РЕЗУЛЬТАТЫ ИССЛЕДОВАНИЙ (Тяжелые output-папки)
# ==========================================
trade_flow_outputs_*/
# (Это автоматически игнорирует trade_flow_outputs_GAZP, trade_flow_outputs_SBER, и т.д.)

# ==========================================
# 4. СЕКРЕТЫ И КЛЮЧИ (Критически важно!)
# ==========================================
API.env
.env
.env.local
*.env
tokens.json
secrets/

# ==========================================
# 5. БИНАРНЫЕ ФАЙЛЫ МОДЕЛЕЙ (Не коммитим)
# ==========================================
*.pkl
*.joblib
*.h5
*.pt
*.onnx

# ==========================================
# 6. Стандартный мусор Python и IDE
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.log
logs/
.vscode/
.idea/
*.swp
*.swo
.ipynb_checkpoints/
